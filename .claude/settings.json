{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run *)", "Bash(npm test *)", "Bash(npx vitest *)",
      "Bash(uv run *)", "Bash(uv sync *)",
      "Bash(git add *)", "Bash(git commit *)", "Bash(git checkout -b *)",
      "Bash(git status *)", "Bash(git diff *)", "Bash(git log *)",
      "Bash(python3 .claude/skills/changelog/changelog.py *)"
    ],
    "ask": ["Bash(docker compose *)", "Bash(gh *)"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f package.json ]; then npm run format --silent; elif [ -f pyproject.toml ]; then uv run ruff format .; fi >/dev/null 2>&1 || true"
          }
        ]
      }
    ]
  }
}
